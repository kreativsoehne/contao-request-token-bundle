{
    "name": "kreativsoehne/contao-request-token-bundle",
    "description": "Keeps Contao 4.13 forms working behind a consent tool: when a page went out without its request token, the form fetches one right before it is sent, instead of failing with \"Invalid request token\".",
    "type": "contao-bundle",
    "license": "MIT",
    "keywords": [
        "contao",
        "request token",
        "csrf",
        "form",
        "consent",
        "cookie"
    ],
    "authors": [
        {
            "name": "Kreativ&Söhne GmbH",
            "homepage": "https://www.kreativundsoehne.de"
        }
    ],
    "require": {
        "php": "^8.1",
        "contao/manager-plugin": "^2.0",
        "symfony/config": "^5.4 || ^6.4",
        "symfony/dependency-injection": "^5.4 || ^6.4",
        "symfony/http-foundation": "^5.4 || ^6.4",
        "symfony/http-kernel": "^5.4 || ^6.4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.40",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^10.5 || ^11.0",
        "rector/rector": "^2.0"
    },
    "conflict": {
        "contao/core-bundle": "<4.13 || >=5.0",
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "autoload": {
        "psr-4": {
            "KreativSoehne\\ContaoRequestTokenBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KreativSoehne\\ContaoRequestTokenBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "fix": [
            "@php vendor/bin/rector process",
            "@php vendor/bin/php-cs-fixer fix"
        ],
        "lint": [
            "@php vendor/bin/php-cs-fixer fix --dry-run --diff",
            "@php vendor/bin/phpstan analyse",
            "@php vendor/bin/rector process --dry-run"
        ],
        "test": "@php vendor/bin/phpunit"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "contao/manager-plugin": false,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0-dev"
        },
        "contao-manager-plugin": "KreativSoehne\\ContaoRequestTokenBundle\\ContaoManager\\Plugin"
    }
}
